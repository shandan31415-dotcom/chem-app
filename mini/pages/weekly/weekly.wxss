.wk-hd {
  padding: 22px 18px 18px;
  text-align: center;
}

.wk-l {
  font-size: 12.5px;
  color: var(--c-sub, #6b7785);
  letter-spacing: 1px;
}

.wk-n {
  font-size: 46px;
  font-weight: 500;
  line-height: 1.15;
  color: var(--c-text, #1c2530);
  margin: 4px 0 2px;
}

.wk-u {
  font-size: 15px;
  margin-left: 4px;
  color: var(--c-sub, #6b7785);
}

.wk-r {
  font-size: 12px;
  color: var(--c-sub, #6b7785);
}

.wk-s {
  font-size: 11.5px;
  color: var(--c-faint, #98a3b1);
  margin-top: 10px;
  line-height: 1.6;
}

.wk-acts {
  display: flex;
  gap: 10px;
  padding: 2px 4px 4px;
}

.wk-btn {
  flex: 1;
  text-align: center;
  font-size: 14px;
  padding: 11px 0;
  border-radius: 10px;
  background: #fff;
  border: 1px solid rgba(0, 0, 0, 0.08);
  color: var(--c-text, #1c2530);
  line-height: 1.4;
}

.wk-btn.share {
  background: #1f6f5c;
  color: #fff;
  border-color: #1f6f5c;
}

.wk-btn::after {
  border: none;
}

.wk-more {
  color: var(--c-sub, #6b7785);
  font-size: 12.5px;
}
