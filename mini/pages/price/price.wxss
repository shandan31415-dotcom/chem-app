.bigpx {
  padding: 16px 14px 14px;
}
.bigpx .pxv {
  display: block;
  font-size: 30px;
  font-weight: 700;
  line-height: 1.15;
}
.bigpx .chgv {
  display: block;
  font-size: 14px;
  font-weight: 500;
  margin-top: 4px;
}

.chartwrap {
  padding: 4px 10px 0;
  height: 190px;
}
.chart {
  width: 100%;
  height: 190px;
  display: block;
}

.periods {
  display: flex;
  gap: 7px;
  padding: 10px 14px 13px;
}
.periods .per {
  flex: 1;
  text-align: center;
  border: 1px solid #e8eaee;
  background: #fff;
  color: #6b7280;
  border-radius: 9px;
  padding: 7px 0;
  font-size: 12.5px;
  line-height: 1.2;
}
.periods .per.on {
  background: #e7f3f0;
  border-color: #0b6b5e;
  color: #0b6b5e;
  font-weight: 600;
}
