.scalebar {
  margin: 10px 14px 0;
  padding: 8px 10px;
  background: #f7f9f9;
  border-left: 2.5px solid #8ec7b9;
  border-radius: 0 8px 8px 0;
  font-size: 12.5px;
  color: #4b5563;
  line-height: 1.7;
}

.pills {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  padding: 0 2px 8px;
}
.pill {
  display: inline-block;
  border: 1px solid #e8eaee;
  background: #fff;
  border-radius: 15px;
  padding: 5px 11px;
  font-size: 12.5px;
  color: #4b5563;
  line-height: 1.3;
}
.pill.hev {
  background: #e7f3f0;
  border-color: #bfded6;
  color: #0b6b5e;
  font-weight: 500;
}

.angle {
  margin: 12px 0 4px;
  padding: 12px 14px;
  background: #fff;
  border-left: 3px solid #0b6b5e;
  border-radius: 0 12px 12px 0;
  font-size: 13.5px;
  line-height: 1.78;
  color: #2b3138;
  box-shadow: 0 1px 2px rgba(16, 24, 40, 0.045);
}
