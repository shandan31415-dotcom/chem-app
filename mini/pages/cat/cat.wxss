.stagebar {
  display: flex;
  align-items: baseline;
  gap: 8px;
  padding: 9px 12px;
  flex-wrap: wrap;
}
.stagedesc {
  font-size: 12px;
  color: #6b7280;
  line-height: 1.6;
  flex: 1;
  min-width: 180px;
}

.prodwrap {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  padding: 12px 14px;
}
.prodwrap .tag {
  font-size: 12px;
  padding: 4px 9px;
  border-radius: 7px;
}

.lk {
  color: #0b6b5e;
  font-size: 11.5px;
  text-decoration: underline;
}
