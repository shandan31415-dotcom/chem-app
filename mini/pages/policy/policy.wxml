<view class="wrap" wx:if="{{p}}">

  <view class="dt" style="font-size:18px;line-height:1.45">{{p.title}}</view>
  <view class="dsub">{{p.level}} · {{p.org}}</view>

  <view class="card">
    <view class="kv"><text class="k">发布层级</text><text class="v">{{p.level}}</text></view>
    <view class="kv"><text class="k">发文机关</text><text class="v">{{p.org}}</text></view>
    <view class="kv"><text class="k">发布日期</text><text class="v">{{p.date}}</text></view>
  </view>

  <block wx:if="{{p.impact}}">
    <view class="sec-title">对行业的影响</view>
    <view class="card">
      <view class="field"><view class="fv">{{p.impact}}</view></view>
      <view class="hint" style="padding:0 14px 12px">{{impactHint}}具体条款以原文为准。</view>
    </view>
  </block>

  <view class="card">
    <view class="row" bindtap="onCopy">
      <view class="main">
        <view class="rt">复制政策原文链接</view>
        <view class="rm">微信内不能跳政府网站，复制后用手机浏览器打开</view>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="btnrow">
      <view class="btn {{faved ? 'pri' : ''}}" bindtap="onFav">{{faved ? '★ 已收藏' : '☆ 收藏这条政策'}}</view>
    </view>
  </view>

  <view class="hint">第一版只做收录与原文链接，不做全文摘要（避免误读政策）。</view>

  <view class="disclaimer">{{disclaimer}}</view>

</view>

<view class="empty" wx:else>未找到该政策</view>
